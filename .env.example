# --- Runtime ---
# development | test | production  (controls `trace` in error envelopes: dev-only)
NODE_ENV=development
# api | worker | all  — role this process plays
ROLE=all
HOST=127.0.0.1
PORT=8080
# Number of reverse proxies in front of the app (for X-Forwarded-For trust).
# 0 = direct / no proxy. Set to 1 behind a single nginx.
TRUST_PROXY=0

# --- Database (PostgreSQL 15+) ---
DATABASE_URL=postgresql://aichat:changeme@127.0.0.1:5432/aichat
DB_POOL_MAX=20
TEST_DATABASE_URL=postgresql://aichat:changeme@127.0.0.1:5432/aichat_test

# --- cache / rate limit ---
# REDIS_URL=redis://127.0.0.1:6379

# --- Sessions ---
SESSION_COOKIE_NAME=__Host-session
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_MINUTES=1440
# Generate: openssl rand -hex 32
SESSION_SECRET=dev-only-insecure-secret-change-me-32chars

# --- Storage ---
STORAGE_LOCAL_ROOT=./.var/files
STORAGE_WRITE_PROVIDER=local
# Minimum free space (MiB) required before accepting an upload; if below, it will 503.
STORAGE_MIN_FREE_MIB=512

# --- Quota ---
QUOTA_TIMEZONE=Asia/Jakarta
MAX_ACTIVE_GENERATIONS=2
# Stop accepting new generations when fewer than this many event-loop slots free.
SERVICE_BUSY_THRESHOLD=0.9

# --- Auth policy ---
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15

# --- Retention ---
# Days an unattached/expired uploaded file blob is kept before purge.
FILE_RETENTION_HOURS=24
# Keep extracted document text after the binary expires.
RETAIN_EXTRACTIONS=true

# --- Observability ---
LOG_LEVEL=info
# NEVER true in production. When false, message text, prompts, file bytes,
# provider bodies, emails and secrets are never logged.
LOG_CONTENT=false

# --- CORS ---
# Comma-separated exact origins. Leave empty when the SPA and API share an origin.
ALLOWED_ORIGINS=

# --- Metrics ---
# Optional bearer token required by GET /metrics. Empty = no auth (bind to localhost).
METRICS_TOKEN=

# --- Jobs (PostgreSQL-backed queue) ---
JOB_POLL_INTERVAL_MS=1000
JOB_POLL_INTERVAL_IDLE_MS=5000

# --- Provider API keys ---
# Keys are referenced by name from `ai_providers.secret_ref` and resolved at boot.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
