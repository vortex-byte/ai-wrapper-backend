# --- Runtime ---
# development | test | production  (controls `trace` in error envelopes: dev-only)
NODE_ENV=development
# api | worker | all  — role this process plays
ROLE=all
HOST=127.0.0.1
PORT=8080
# Number of reverse proxies in front of the app (for X-Forwarded-For trust).
# 0 = direct / no proxy. Set to 1 behind a single nginx.
TRUST_PROXY=0

# --- Database (PostgreSQL 15+) ---
DATABASE_URL=postgresql://aiwrapper:changeme@127.0.0.1:5432/aiwrapper
DB_POOL_MAX=20
# Only on development
TEST_DATABASE_URL=postgresql://aiwrapper:changeme@127.0.0.1:5432/aiwrapper_test
# Migration CLI only (deploy: the DDL-owning `aiwrapper_migrator` role)
# Leave unset in dev to migrate with DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://aiwrapper_migrator:changeme@127.0.0.1:5432/aiwrapper

# --- Sessions ---
# Sessions idle/lockout policy lives in admin Settings (security.config) — not here.
SESSION_COOKIE_NAME=__Host-session
SESSION_ABSOLUTE_MINUTES=1440
# Generate: openssl rand -hex 32
SESSION_SECRET=change-me-32chars

# --- Storage ---
STORAGE_LOCAL_ROOT=./.var/files
# Minimum free space (MiB) required before accepting an upload; if below, it will 503.
STORAGE_MIN_FREE_MIB=512

# --- Generations ---
# Hard limit concurrent live generations.
MAX_ACTIVE_GENERATIONS=150

# --- Auth policy ---
PASSWORD_MIN_LENGTH=8

# --- Observability ---
LOG_LEVEL=info
LOG_DIR=./.var/logs
# Rotated archives older than this many days are deleted automatically.
LOG_FILE_RETENTION_DAYS=14
# Rotate early once a single file exceeds this size.
LOG_MAX_SIZE=20m
# Disable to log only to stdout.
LOG_TO_FILES=true

# --- CORS ---
# Comma-separated exact origins. Leave empty when the SPA and API share an origin.
ALLOWED_ORIGINS=

# --- Rate limiting (requests per fixed window) ---
RATE_LIMIT_WINDOW_SECONDS=60
# Per IP on the unauthenticated/auth surface (`/api/auth/*`).
RATE_LIMIT_IP_REQUESTS=60
# Coarse per-IP abuse ceiling for the whole `/api` tree. Keep it high enough for an
# office sharing one NAT address (the real per-user limit is RATE_LIMIT_USER_REQUESTS).
RATE_LIMIT_API_IP_REQUESTS=600
RATE_LIMIT_USER_REQUESTS=300
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_UPLOAD_REQUESTS=30
RATE_LIMIT_GENERATION_REQUESTS=20
RATE_LIMIT_REPORTING_REQUESTS=60

# --- Conversation retention ---
# Days a soft-deleted conversation is kept before the daily purge removes its rows and blobs.
CONVERSATION_RETENTION_DAYS=30

# --- Jobs (PostgreSQL-backed queue) ---
JOB_POLL_INTERVAL_MS=1000
JOB_POLL_INTERVAL_IDLE_MS=5000

# --- Provider API keys ---
# Keys are referenced by name from `ai_providers.secret_ref` and resolved at boot.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
