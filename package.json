{
  "name": "ai-chat-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/server.ts",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "build": "bun build src/server.ts --target bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src",
    "test": "bun --bun run vitest run",
    "test:watch": "bun --bun run vitest",
    "test:integration": "bun --bun run vitest run --config vitest.integration.config.ts",
    "verify": "bun run typecheck && bun run lint && bun run depcruise && bun run test",
    "db:migrate": "bun run src/cli/index.ts migrate",
    "db:migrate:check": "bun run src/cli/index.ts migrate:check",
    "db:seed:example": "bun run src/cli/index.ts seed-example",
    "cli": "bun run src/cli/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@google/genai": "^2.28.0",
    "@hono/bun": "^1.0.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "js-tiktoken": "^1.0.21",
    "openai": "^7.30.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "typescript": "^6",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
